// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  password         String            @default("password123")
  role             String            @default("MAHASISWA") // "MAHASISWA" | "MITRA"
  university       String?           @default("Institut Teknologi Bandung")
  semester         String?           @default("Semester 6 - Teknik Informatika")
  gpa              String?           @default("3.88")
  companyName      String?
  createdAt        DateTime          @default(now())
  
  competencyVector CompetencyVector?
  applications     Application[]
  postedProjects   Project[]         @relation("MitraProjects")
}

model CompetencyVector {
  id           String   @id @default(cuid())
  userId       String   @unique
  aiml         Int      @default(92)
  frontend     Int      @default(85)
  uiux         Int      @default(78)
  backend      Int      @default(90)
  architecture Int      @default(84)
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id              String   @id @default(cuid())
  title           String
  company         String
  category        String   @default("AI & Machine Learning")
  workType        String   @default("Hybrid")
  duration        String   @default("3 Bulan")
  stipend         String   @default("Rp 4.500.000 / bln")
  description     String
  skillsRequired  String   // Stored as comma-separated or JSON string
  reqAiml         Int      @default(85)
  reqFrontend     Int      @default(70)
  reqUiux         Int      @default(65)
  reqBackend      Int      @default(80)
  reqArchitecture Int      @default(75)
  verified        Boolean  @default(true)
  postedAt        DateTime @default(now())
  
  createdById     String?
  createdBy       User?    @relation("MitraProjects", fields: [createdById], references: [id], onDelete: SetNull)
  applications    Application[]
}

model Application {
  id         String   @id @default(cuid())
  projectId  String
  userId     String
  matchScore Int      @default(90)
  status     String   @default("SUBMITTED") // "SUBMITTED" | "REVIEWING" | "ACCEPTED" | "REJECTED"
  appliedAt  DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
