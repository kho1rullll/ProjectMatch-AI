{
  "name": "projectmatch-ai-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix nextjs-app",
    "build": "npm run build --prefix nextjs-app",
    "start": "npm run start --prefix nextjs-app",
    "lint": "npm run lint --prefix nextjs-app",
    "backend:dev": "python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload --app-dir backend",
    "backend:test": "python backend/tests/test_backend.py",
    "frontend:test": "npm run test --prefix nextjs-app",
    "test:all": "python backend/tests/test_backend.py && npm run test --prefix nextjs-app",
    "module8:dev": "npm run dev --prefix module-8-vite",
    "module8:build": "npm run build --prefix module-8-vite",
    "module8:lint": "npm run lint --prefix module-8-vite",
    "module8:check": "npm run check --prefix module-8-vite"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "framer-motion": "^14.4.0",
    "lucide-react": "^1.60.0"
  }
}
