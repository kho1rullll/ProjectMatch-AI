PROJECT_NAME="ProjectMatch AI Backend"
API_V1_STR="/api/v1"
SECRET_KEY="projectmatch-super-secret-jwt-key-2026-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL 15+ dengan pgvector atau SQLite lokal)
DATABASE_URL="sqlite:///./projectmatch_ai.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/projectmatch_db"

# Groq Cloud API (Dapatkan API Key di console.groq.com)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"

# GitHub REST API (Opsional: Personal Access Token untuk menghindari rate limit)
GITHUB_TOKEN=""

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
